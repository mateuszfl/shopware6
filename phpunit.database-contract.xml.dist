<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/11.5/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         cacheDirectory=".phpunit.cache/database-contract"
         cacheResult="false"
         failOnRisky="true">
    <php>
        <ini name="error_reporting" value="-1"/>
        <ini name="memory_limit" value="-1"/>
        <server name="TESTS_RUNNING" value="1"/>
    </php>
    <testsuites>
        <testsuite name="database-installer">
            <file>tests/integration/Core/Maintenance/System/Service/SetupDatabaseAdapterTest.php</file>
            <file>tests/integration/Core/Installer/InstallerConfigurationContractTest.php</file>
        </testsuite>
        <testsuite name="database-migrations">
            <file>tests/integration/Core/Framework/Migration/MigrationPlatformContractTest.php</file>
        </testsuite>
        <testsuite name="database-migrations-v63">
            <file>tests/integration/Core/Migration/V6_3/InitialSchemaPostgreSQLTest.php</file>
        </testsuite>
        <testsuite name="database-contract">
            <file>tests/integration/Core/Framework/DataAbstractionLayer/Contract/DatabaseContractTest.php</file>
            <file>tests/integration/Core/Framework/DataAbstractionLayer/Contract/SharedRuntimeSqlContractTest.php</file>
        </testsuite>
        <testsuite name="database-dal-reader">
            <file>tests/integration/Core/Framework/DataAbstractionLayer/Contract/EntityReaderContractTest.php</file>
        </testsuite>
        <testsuite name="database-dal-json">
            <file>tests/integration/Core/Framework/DataAbstractionLayer/Contract/JsonAccessorContractTest.php</file>
            <file>tests/integration/Core/Framework/DataAbstractionLayer/Contract/JsonCriteriaContractTest.php</file>
        </testsuite>
        <testsuite name="database-dal-write">
            <file>tests/integration/Core/Framework/DataAbstractionLayer/Contract/EntityWriteContractTest.php</file>
        </testsuite>
        <testsuite name="database-dal-search">
            <file>tests/integration/Core/Framework/DataAbstractionLayer/Contract/CriteriaSearchAggregationContractTest.php</file>
        </testsuite>
        <testsuite name="database-dal-schema">
            <file>tests/integration/Core/Framework/Adapter/Database/DatabaseSchemaTest.php</file>
            <file>tests/integration/Core/Framework/DataAbstractionLayer/Contract/SchemaContractTest.php</file>
        </testsuite>
        <testsuite name="database-indexers">
            <file>tests/integration/Core/Framework/DataAbstractionLayer/Contract/IndexingContractTest.php</file>
        </testsuite>
        <testsuite name="database-search">
            <file>tests/integration/Elasticsearch/Admin/ElasticsearchIndexingDatabaseContractTest.php</file>
        </testsuite>
        <testsuite name="database-ui">
            <file>tests/integration/Administration/Dashboard/OrderAmountDatabaseContractTest.php</file>
            <file>tests/integration/Administration/Snippet/SnippetDatabaseContractTest.php</file>
            <file>tests/integration/Storefront/Theme/ThemeDatabaseContractTest.php</file>
        </testsuite>
        <testsuite name="database-content">
            <file>tests/integration/Core/Framework/DataAbstractionLayer/Contract/ContentSqlContractTest.php</file>
        </testsuite>
        <testsuite name="database-checkout">
            <file>tests/integration/Core/Checkout/Contract/CheckoutPersistenceContractTest.php</file>
            <file>tests/integration/Core/Checkout/Contract/PromotionCodeGatewayTest.php</file>
            <file>tests/integration/Core/Checkout/Contract/PaymentSqlContractTest.php</file>
        </testsuite>
        <testsuite name="database-system">
            <directory>tests/integration/Core/System/Contract</directory>
        </testsuite>
        <testsuite name="database-framework">
            <directory>tests/integration/Core/Framework/Contract</directory>
        </testsuite>
        <testsuite name="database-functions">
            <file>tests/integration/Core/Framework/Adapter/Database/DatabaseFunctionInstallerTest.php</file>
        </testsuite>
        <testsuite name="database-contract-replication">
            <file>tests/integration/Core/Framework/DataAbstractionLayer/Contract/PostgreSQLReplicationFixtureTest.php</file>
        </testsuite>
        <testsuite name="database-replica-routing">
            <file>tests/integration/Core/Framework/Adapter/Database/ReplicaRoutingContractTest.php</file>
        </testsuite>
        <testsuite name="database-replica-failures">
            <file>tests/integration/Core/Framework/Adapter/Database/PostgreSQLReplicaFailureContractTest.php</file>
        </testsuite>
        <testsuite name="database-two-replicas">
            <file>tests/integration/Core/Framework/Adapter/Database/PostgreSQLTwoReplicaContractTest.php</file>
        </testsuite>
        <testsuite name="database-replica-restart-host">
            <file>tests/integration/Core/Framework/Adapter/Database/PostgreSQLReplicaRestartContractTest.php</file>
        </testsuite>
    </testsuites>
</phpunit>
