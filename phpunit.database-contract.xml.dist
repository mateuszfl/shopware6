<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/11.5/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         cacheDirectory=".phpunit.cache/database-contract"
         cacheResult="false"
         failOnRisky="true">
    <php>
        <ini name="error_reporting" value="-1"/>
        <ini name="memory_limit" value="-1"/>
        <server name="TESTS_RUNNING" value="1"/>
    </php>
    <testsuites>
        <testsuite name="database-contract">
            <file>tests/integration/Core/Framework/DataAbstractionLayer/Contract/DatabaseContractTest.php</file>
        </testsuite>
        <testsuite name="database-dal-reader">
            <file>tests/integration/Core/Framework/DataAbstractionLayer/Contract/EntityReaderContractTest.php</file>
        </testsuite>
        <testsuite name="database-dal-json">
            <file>tests/integration/Core/Framework/DataAbstractionLayer/Contract/JsonAccessorContractTest.php</file>
            <file>tests/integration/Core/Framework/DataAbstractionLayer/Contract/JsonCriteriaContractTest.php</file>
        </testsuite>
        <testsuite name="database-dal-write">
            <file>tests/integration/Core/Framework/DataAbstractionLayer/Contract/EntityWriteContractTest.php</file>
        </testsuite>
        <testsuite name="database-dal-search">
            <file>tests/integration/Core/Framework/DataAbstractionLayer/Contract/CriteriaSearchAggregationContractTest.php</file>
        </testsuite>
        <testsuite name="database-contract-replication">
            <file>tests/integration/Core/Framework/DataAbstractionLayer/Contract/PostgreSQLReplicationFixtureTest.php</file>
        </testsuite>
        <testsuite name="database-replica-routing">
            <file>tests/integration/Core/Framework/Adapter/Database/ReplicaRoutingContractTest.php</file>
        </testsuite>
        <testsuite name="database-replica-failures">
            <file>tests/integration/Core/Framework/Adapter/Database/PostgreSQLReplicaFailureContractTest.php</file>
        </testsuite>
        <testsuite name="database-two-replicas">
            <file>tests/integration/Core/Framework/Adapter/Database/PostgreSQLTwoReplicaContractTest.php</file>
        </testsuite>
        <testsuite name="database-replica-restart-host">
            <file>tests/integration/Core/Framework/Adapter/Database/PostgreSQLReplicaRestartContractTest.php</file>
        </testsuite>
    </testsuites>
</phpunit>
