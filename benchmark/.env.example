# Copy to benchmark/.env. Use only benchmark credentials here.
SHOPWARE_FRANKENPHP_IMAGE=ghcr.io/shopware/docker-base:8.4.28-frankenphp@sha256:3676a352c995ed07216d2b1dcae980e552955b7420d222db4bb191fa42dde9db

# Leave bound to localhost and use an SSH tunnel for remote load generation.
APP_BIND_IP=127.0.0.1
APP_PORT=8000
SHOP_URL=http://localhost:8000

# Adminer is only started with --profile tools and binds to localhost.
ADMINER_BIND_IP=127.0.0.1
ADMINER_PORT=8081

# Starting profile for a 4 vCPU / 8 GB VPS: 2 vCPU + 2 GB for app,
# 2 vCPU + 4 GB for DB, with the rest reserved for the OS and file cache.
APP_CPUS=2.0
APP_MEMORY_LIMIT=2g
DB_CPUS=2.0
DB_MEMORY_LIMIT=4g

BENCHMARK_DB_NAME=shopware_bench
BENCHMARK_DB_USER=shopware_bench
BENCHMARK_DB_PASSWORD=bench_only_change_me
BENCHMARK_DB_ADMIN_PASSWORD=bench_admin_only_change_me
APP_SECRET=benchmark_only_change_me_to_a_long_random_value
